{
  "name": "dragon-ball-arena",
  "displayName": "Dragon Ball Arena",
  "description": "Compact animated VS Code arena with inward-facing Goku, Vegeta, Broly, Gohan, Frieza, Trunks and Piccolo fighters, smooth battle animations, HP, rounds and effects.",
  "version": "2.1.2",
  "publisher": "awais4212",
  "icon": "media/marketplace-icon.png",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/awais4212/vscode-dragon-ball-arena.git"
  },
  "homepage": "https://github.com/awais4212/vscode-dragon-ball-arena#readme",
  "bugs": {
    "url": "https://github.com/awais4212/vscode-dragon-ball-arena/issues"
  },
  "engines": {
    "vscode": "^1.85.0"
  },
  "categories": [
    "Other"
  ],
  "main": "./out/extension.js",
  "activationEvents": [
    "onView:dragonBallArena.view",
    "onCommand:dragonBallArena.reset"
  ],
  "contributes": {
    "views": {
      "explorer": [
        {
          "type": "webview",
          "id": "dragonBallArena.view",
          "name": "Dragon Ball Arena",
          "icon": "media/marketplace-icon.png",
          "visibility": "visible"
        }
      ]
    },
    "commands": [
      {
        "command": "dragonBallArena.reset",
        "title": "Dragon Ball Arena: Reset Match",
        "icon": "$(debug-restart)"
      }
    ],
    "menus": {
      "view/title": [
        {
          "command": "dragonBallArena.reset",
          "when": "view == dragonBallArena.view",
          "group": "navigation"
        }
      ]
    }
  },
  "scripts": {
    "compile": "tsc -p ./",
    "watch": "tsc -w -p ./"
  },
  "devDependencies": {
    "@vscode/vsce": "^3.9.2",
    "typescript": "^5.9.2"
  }
}